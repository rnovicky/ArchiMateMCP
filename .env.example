# Copy this file to .env and adjust values before running.
# The server reads the .env of its own folder, wherever it is started from.

# The ArchiMate API: its root URL (without /api/v2) and a key of it.
# A key with the role "reader" is enough for every reading tool; writing needs
# ALLOW_WRITE below and a key with the role "editor". See "API keys and roles" in
# the API's README for giving the server a key of its own.
API_URL=http://127.0.0.1:8000
API_KEY=change-me
# Seconds one request to the API may take.
#API_TIMEOUT=60

# The model the tools read when the assistant does not say which: an id or a
# name. Empty: the only model there is; with several, the tools ask.
#DEFAULT_MODEL=
# Most items in one list of an answer (search results, a view's elements, an
# element's relationships...): the larger, the more of the assistant's context
# one answer takes. 1 to 1000.
#MAX_RESULTS=100
# The ArchiMate Browser, as its users open it (e.g. http://127.0.0.1:8090/).
# When set, answers carry links that open what they describe there as a
# diagram. Empty: no links.
#BROWSER_URL=

# Images of diagrams (diagram_image, 1.12.0): the ArchiMate Browser draws them in
# Chrome or Edge without a window, for reports and documents. The server starts a
# Browser server of its own for it, on a free port of 127.0.0.1; the Browser need
# not be running. Its folder (2.29.0 or later); empty: ArchiMateBrowser next to
# this server's folder.
#BROWSER_DIR=
# Where the images are saved (relative to the server's folder); the tool's file
# names stay inside it.
#IMAGE_DIR=images
# The browser to draw in: auto (Chrome, else Edge), chrome, msedge, or the path
# of a Chromium-based browser's .exe.
#RENDER_BROWSER=auto
# Seconds one diagram may take; seconds without an image after which the browser
# and the Browser server stop (0: they run until this server stops).
#RENDER_TIMEOUT=120
#RENDER_IDLE=300

# The HTTP transport (archimatemcp.bat start): clients connect to
# http://HOST:PORT/mcp. Over stdio (Claude Desktop, Claude Code) these are not used.
# A loopback HOST (127.0.0.1) listens on 127.0.0.1 and ::1.
HOST=127.0.0.1
PORT=8100
# HTTP clients send this as "Authorization: Bearer <token>". Required unless HOST
# is a loopback address; any long random text, e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#MCP_TOKEN=
# Instead of MCP_TOKEN (1.7.0): every HTTP client sends its own key of the
# ArchiMate API as "Authorization: Bearer <key>", and the server works with that
# key for that client: the API's record of changes names the person, and the
# write tools follow their role. API_KEY may then stay empty.
#CLIENT_KEYS=false

# Writing (1.3.0): with ALLOW_WRITE=true and a key with the role "editor", the
# assistant can create, change and delete elements, relationships, properties and
# their folders. Off by default: the server only reads.
#ALLOW_WRITE=false
# Every write is recorded, one JSON line each, in this file (relative to the
# server's folder). Empty (the default since 1.7.0): in the server's log only;
# the ArchiMate API keeps the record of changes that counts (model_history).
#CHANGE_LOG=changes.log
